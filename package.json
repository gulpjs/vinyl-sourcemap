{
  "name": "vinyl-sourcemap",
  "version": "3.0.0",
  "description": "Add/write sourcemaps to/from Vinyl files.",
  "author": "Gulp Team <team@gulpjs.com> (https://gulpjs.com/)",
  "contributors": [
    "Robin Venneman",
    "Blaine Bublitz <blaine.bublitz@gmail.com>"
  ],
  "funding": "https://github.com/sponsors/gulpjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulpjs/vinyl-sourcemap.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22.15.0"
  },
  "main": "./index.js",
  "files": [
    "LICENSE",
    "index.js",
    "lib/"
  ],
  "scripts": {
    "format-check": "prettier . --check",
    "format-write": "prettier . --write",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=test/lcov.info \"test/*.js\""
  },
  "dependencies": {
    "convert-source-map": "^2.0.0",
    "graceful-fs": "^4.2.10",
    "now-and-later": "^3.0.0",
    "streamx": "^2.12.5",
    "vinyl": "^3.0.0",
    "vinyl-contents": "^2.0.0"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-gulp": "7.0.0",
    "prettier": "3.9.6",
    "readable-stream": "^3.6.0"
  },
  "keywords": [
    "vinyl",
    "sourcemap",
    "gulp"
  ]
}
